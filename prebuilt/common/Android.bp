prebuilt_etc_xml {
    name: "apns-conf.xml",
    product_specific: true,
    src: "etc/apns-conf.xml",
    schema: ":apns-conf-schema",
}

prebuilt_etc_xml {
    name: "sensitive_pn.xml",
    product_specific: true,
    src: "etc/sensitive_pn.xml",
    schema: ":spn-schema",
}

prebuilt_etc_xml {
    name: "lmodroid-component-overrides.xml",
    product_specific: true,
    src: "etc/lmodroid-component-overrides.xml",
    sub_dir: "sysconfig",
}

prebuilt_etc_xml {
    name: "fdroid-additional-repos",
    product_specific: true,
    src: "etc/org.fdroid.fdroid/additional_repos.xml",
    filename_from_src: true,
    sub_dir: "org.fdroid.fdroid",
}
